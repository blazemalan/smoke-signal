# Normalize line endings: LF in repo and working tree for code,
# CRLF for Windows batch/PowerShell scripts which require it.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never touch line endings
*.png binary
*.ico binary
*.db binary
*.wav binary
*.m4a binary
*.mp3 binary
